# Database
DATABASE_URL=mysql://user:password@localhost:3306/delivery_app

# Server (Fastify). `apps/web` Vite dev proxy reads this same `PORT` so /api → API (avoid ECONNREFUSED).
PORT=3005
APP_URL=http://localhost:3005
NODE_ENV=development

# JWT Secrets (generate your own for production)
JWT_SECRET=your_jwt_secret_at_least_32_characters_long
JWT_REFRESH_SECRET=your_jwt_refresh_secret_at_least_32_characters_long
JWT_EXPIRES_IN=7d

# Redis for sessions (optional for local development)
REDIS_URL=redis://localhost:6379

# CORS - Frontend URL
CORS_ORIGINS=http://localhost:5177
WEB_PORT=5177

# Frontend: for `pnpm dev` in apps/web, leave VITE_API_URL unset or empty so requests stay on the
# Vite origin and `vite.config.ts` proxies /api → the API (no CORS). Use explicit URLs when not
# using the Vite dev server (e.g. E2E on fixed ports, or preview against a remote API).
# VITE_API_URL=http://localhost:3005
# WebSocket to the API (port must match `PORT` above).
VITE_WS_URL=ws://localhost:3005/realtime

# Stripe (required for production). For local testing use TEST keys from the Stripe dashboard
# (Test mode → Developers → API keys): checkout then takes test cards such as 4242 4242 4242 4242.
# Both keys must be the same mode; the API refuses to start with one test and one live key.
# The webhook secret comes from `stripe listen --forward-to localhost:3005/webhooks/stripe`; without it
# card orders stay PENDING_PAYMENT and the vendor is never told.
# Then give a store a test connected account: pnpm --filter @packages/db stripe:test-vendor <store slug>
# and check the whole flow: pnpm --filter @apps/server smoke:order -- <store slug>
STRIPE_SECRET_KEY=your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=your_stripe_webhook_secret
VITE_STRIPE_PUBLISHABLE_KEY=your_stripe_publishable_key
# Cash at pickup/delivery, for testing orders without Stripe. Set both (API + web build).
# ENABLE_COD_PAYMENTS=true
# VITE_ENABLE_COD_PAYMENTS=true

# Storage
STORAGE_TYPE=local
UPLOAD_DIR=./uploads

# Delivery addresses. Production needs a precise geocoder (Mapbox: autocomplete + rooftop positions);
# without one it refuses to start unless ALLOW_APPROXIMATE_DELIVERY is set to false (no delivery)
# or true (decide delivery from ZIP-code centers, knowingly).
MAPBOX_ACCESS_TOKEN=your_mapbox_access_token
# ALLOW_APPROXIMATE_DELIVERY=false
# Positionstack positions only, no autocomplete (optional fallback)
GEOCODING_API_KEY=your_geocoding_api_key

# Sales tax: stripe (default in production) or estimate (development; production needs ALLOW_ESTIMATED_TAX=true)
# TAX_PROVIDER=stripe

# Error Reporting (optional)
ERROR_ENDPOINT=your_error_reporting_endpoint

# Application URL
APP_URL=http://localhost:3005

# DoorDash Drive webhooks — use HTTPS in staging/production.
# Public Drive docs: protect endpoints with Basic Auth or OAuth (signing headers are tenant-specific).
# When NODE_ENV=production, DOORDASH_WEBHOOK_AUTH_MODE must be "basic" or "hmac" (never omitted / none).

# Local: open webhook (dev only)
# DOORDASH_WEBHOOK_AUTH_MODE=none

# Local / staging: Basic Auth
# DOORDASH_WEBHOOK_AUTH_MODE=basic
# DOORDASH_WEBHOOK_BASIC_USER=shopshop
# DOORDASH_WEBHOOK_BASIC_PASSWORD=local-secret

# If DoorDash (or your gateway) gives you HMAC over the raw JSON body:
# DOORDASH_WEBHOOK_AUTH_MODE=hmac
# DOORDASH_WEBHOOK_SECRET=
# DOORDASH_WEBHOOK_SIGNATURE_HEADER=x-doordash-signature

DOORDASH_WEBHOOK_AUTH_MODE=none
DOORDASH_WEBHOOK_BASIC_USER=
DOORDASH_WEBHOOK_BASIC_PASSWORD=
DOORDASH_WEBHOOK_SECRET=
DOORDASH_WEBHOOK_SIGNATURE_HEADER=x-doordash-signature