{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "declaration": true,
    "outDir": "dist/generated/sdk",
    "rootDir": "generated/sdk",
    "skipLibCheck": true,
    "esModuleInterop": true,
    "strict": false
  },
  "include": ["generated/sdk/**/*.ts"]
}
